<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="tv.dumbtv.home">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- The cinematic home fetches the weather from Open-Meteo, only when cinema/weather.txt sets a
         location. The light strip looks titles up on TMDB (cinema/tmdb.key) and talks to the Magic
         Home controller on the local network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the watchdog switch the HOME guard back on when Fire OS drops it. Granted over adb
         (pm grant ... WRITE_SECURE_SETTINGS): Android never asks a person for it. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <!-- Fire OS 6 only: the Keeper reads the foreground package through UsageStats.
         maxSdkVersion keeps Fire OS 7/8 on the permission-free accessibility path. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        android:maxSdkVersion="27" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"
        android:maxSdkVersion="27" />
    <uses-permission android:name="android.permission.REORDER_TASKS"
        android:maxSdkVersion="27" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:theme="@style/Home"
        android:allowBackup="false"
        android:supportsRtl="true">

        <activity
            android:name=".Home"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:resumeWhilePausing="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".Library"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode" />

        <!-- Starts with the app's process to keep the HOME guard switched on (see Watchdog). -->
        <provider
            android:name=".Watchdog"
            android:authorities="tv.dumbtv.home.watchdog"
            android:exported="false" />

        <!-- Our results for an Alexa voice search. Its own task, so Back shows Amazon's results. -->
        <activity
            android:name=".Search"
            android:exported="false"
            android:taskAffinity="tv.dumbtv.home.search"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode" />

        <activity
            android:name=".Options"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode" />

        <activity
            android:name=".Input"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode" />

        <!-- Full white, then full black, for the phone that films the screen (lightcam/) to find
             it. Exported so it can also be started with adb. -->
        <activity
            android:name=".Calibrate"
            android:exported="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode" />

        <!-- Plays a test rhythm for the light camera's phone to tune its hearing to. -->
        <activity
            android:name=".SoundCalibrate"
            android:exported="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode" />

        <service
            android:name=".Keeper"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The TV's screensaver: wallpapers, clock, weather and the film's name. -->
        <service
            android:name=".Dream"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <service
            android:name=".Guard"
            android:label="@string/guard_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/guard" />
        </service>
        <!-- Sees what's playing (media sessions) for the light strip. Enabled by deploy.sh with
             cmd notification allow_listener; it reads no notifications. -->
        <service
            android:name=".Lights"
            android:label="@string/lights_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
